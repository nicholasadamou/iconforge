{
  "name": "iconforge",
  "version": "1.0.0",
  "description": "Create beautiful favicons using Font Awesome icons",
  "author": "Nicholas Adamou",
  "license": "LicenseRef-PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicholasadamou/iconforge"
  },
  "keywords": [
    "favicon",
    "icon",
    "font-awesome",
    "nextjs",
    "react",
    "typescript"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate-icons": "node scripts/generate-icons.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "./scripts/deploy.sh",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:docs": "markdownlint-cli2",
    "lint:diagrams": "node scripts/check-diagrams.mjs",
    "lint:budget": "node scripts/check-budgets.mjs",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run lint:docs && bun run lint:diagrams && bun run lint:budget",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:e2e": "playwright test",
    "verify:production": "bun run build && bun run test:e2e",
    "hooks:install": "pre-commit install --hook-type pre-commit --hook-type pre-push"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fortawesome/fontawesome-free": "6.5.2",
    "file-saver": "^2.0.5",
    "fuse.js": "^7.5.0",
    "mermaid": "^12.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": "24.x"
  }
}
